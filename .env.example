# ── Database ─────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jmd_gems?schema=public"

# ── Auth ─────────────────────────────────────────────────
# openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Payments: Razorpay ───────────────────────────────────
# Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook secret (Dashboard → Webhooks, event: payment.captured)
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ── Media: Cloudinary ────────────────────────────────────
# Leave blank in development — uploads fall back to /public/uploads
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="jmd-gems"

# ── Live metal rates ─────────────────────────────────────
# Goldpricez free tier (30–60 requests/hour). Server only — the proxy caches
# the response for 3 minutes so this key never reaches the browser.
GOLDPRICEZ_API_KEY=""
# USD→INR fallback used only if the free forex API fails (cached 1 hour).
USD_INR_FALLBACK=""

# Metals-API (or compatible) spot feed. Server only — never expose this key.
METAL_API_KEY=""
METAL_API_URL="https://metals-api.com/api/latest"
# Secret sent by Vercel Cron (Authorization: Bearer …)
CRON_SECRET=""

# ── Demo / seed ──────────────────────────────────────────
# When DATABASE_URL is unreachable the app runs against a local
# JSON store (.data/demo-db.json) so the storefront stays browsable.
DEMO_MODE="true"
SEED_ADMIN_EMAIL="admin@jmdgems.in"
SEED_ADMIN_PASSWORD="JmdAdmin@2026"
