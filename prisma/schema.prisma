// JMD Gems & Jewellery — Prisma schema (PostgreSQL)
// npm run db:push && npm run db:seed

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Metal {
  GOLD
  SILVER
  DIAMOND
  GEMSTONE
}

enum MetalColor {
  YELLOW
  WHITE
  ROSE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  READY_FOR_PICKUP
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  STORE
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  phone         String?    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role       @default(USER)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts  Account[]
  sessions  Session[]
  orders    Order[]
  addresses Address[]
  wishlist  Wishlist[]
  reviews   Review[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  nameHi      String?
  description String?
  image       String?
  sortOrder   Int       @default(0)
  products    Product[]
}

model Gemstone {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  nameHi      String?
  color       String
  hex         String
  benefit     String
  benefitHi   String
  originNote  String?
  products    Product[]
}

model Product {
  id              String     @id @default(cuid())
  slug            String     @unique
  name            String
  nameHi          String?
  subtitle        String?
  description     String
  story           String?
  metal           Metal      @default(GOLD)
  metalColor      MetalColor @default(YELLOW)
  purity          String     @default("22K")
  metalWeight     Float
  gemstoneValue   Int        @default(0)
  gemstoneCarats  Float?
  makingPct       Float      @default(12)
  images          String[]
  collections     String[]
  occasions       String[]
  sizes           String[]
  badges          String[]
  certifications  String[]
  certificateNo   String?
  certificateUrl  String?
  stock           Int        @default(0)
  rating          Float      @default(4.8)
  reviewCount     Int        @default(0)
  isFeatured      Boolean    @default(false)
  isNew           Boolean    @default(false)
  isBestseller    Boolean    @default(false)
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  gemstoneId String?
  gemstone   Gemstone? @relation(fields: [gemstoneId], references: [id])

  variants   Variant[]
  reviews    Review[]
  wishlist   Wishlist[]
  orderItems OrderItem[]

  @@index([metal])
  @@index([categoryId])
  @@index([isFeatured])
}

model Variant {
  id         String  @id @default(cuid())
  productId  String
  sku        String  @unique
  size       String
  stock      Int     @default(0)
  priceDelta Int     @default(0)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  label     String  @default("Home")
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Order {
  id                String          @id @default(cuid())
  orderNumber       String          @unique
  userId            String?
  email             String
  phone             String?
  customerName      String?
  status            OrderStatus     @default(PENDING)
  paymentStatus     PaymentStatus   @default(PENDING)
  paymentMethod     PaymentMethod   @default(ONLINE)
  fulfillment       FulfillmentType @default(DELIVERY)
  subtotal          Int
  gst               Int
  shipping          Int             @default(0)
  total             Int
  goldRate          Int
  rateSnapshot      Json?
  rateSnapshotId    String?
  priceBreakup      Json?
  priceLockedUntil  DateTime?
  shippingAddress   Json
  razorpayOrderId   String?
  razorpayPaymentId String?
  trackingNo        String?
  courier           String?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user  User?       @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  productId     String
  slug          String
  name          String
  image         String
  size          String?
  quantity      Int     @default(1)
  unitPrice     Int
  metalWeight   Float
  gemstoneValue Int
  makingCharges Int
  gst           Int
  ratePerGram   Int?
  goldValue     Int?
  priceBreakup  Json?
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String?
  productId String
  rating    Int
  title     String?
  body      String
  author    String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Enquiry {
  id          String        @id @default(cuid())
  name        String
  phone       String
  message     String?
  productSlug String?
  productName String?
  type        String        @default("GENERAL")
  status      EnquiryStatus @default(NEW)
  createdAt   DateTime      @default(now())

  @@index([status])
}

model MetalRate {
  id          String    @id @default(cuid())
  metal       Metal     @default(GOLD)
  purity      String    @unique
  ratePerGram Int
  source      String    @default("MANUAL")
  status      String    @default("PUBLISHED")
  feedRate    Int?
  fetchedAt   DateTime?
  updatedAt   DateTime  @updatedAt
}

model RateSnapshot {
  id          String   @id @default(cuid())
  metal       Metal    @default(GOLD)
  purity      String
  ratePerGram Int
  source      String   @default("MANUAL")
  status      String   @default("PUBLISHED")
  note        String?
  fetchedAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([purity, fetchedAt])
  @@index([status])
}

model RateAudit {
  id      String   @id @default(cuid())
  purity  String
  oldRate Int?
  newRate Int
  actor   String
  action  String
  at      DateTime @default(now())

  @@index([at])
}

model StoreInfo {
  id           String   @id @default(cuid())
  name         String
  address      String
  city         String
  pincode      String
  state        String
  phones       String[]
  hours        String
  mapUrl       String?
  photo        String?
  about        String?
  settings     Json?
  festivalMode Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}
